# Local development (docker compose up -d --wait). Copy to .env; never commit real values.
# In AKS these come from the ConfigMap (non-secret) and Azure Key Vault through the CSI driver.

# api
DATABASE_URL=postgresql://statline:statline@localhost:5432/statline
JWT_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-too-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PREDICCIONES_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
PORT=3000
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@statline.local
SEED_ADMIN_PASSWORD=

# ingesta
API_SPORTS_KEY=
API_SPORTS_DAILY_QUOTA=95
TEMPORADA_BASQUETBOL=2025-2026
TEMPORADA_AMERICANO=2026
TEMPORADA_FUTBOL=2026
SCHEMAS_DIR=./schemas
