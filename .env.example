# Local development (docker compose up -d --wait). Copy to .env; never commit real values.
# In AKS these come from the ConfigMap (non-secret) and Azure Key Vault through the CSI driver.

# api
DATABASE_URL=postgresql://statline:statline@localhost:5432/statline
JWT_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-too-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PREDICCIONES_URL=http://localhost:8000
# deshabilitado (default, POST /api/ingestas/ejecutar answers 503) | kubernetes (creates Jobs from the CronJobs; needs RBAC, see ARCHITECTURE §3.6)
INGESTA_LANZADOR=deshabilitado
INGESTA_CRONJOB_PREFIJO=
PREDICCIONES_TIMEOUT_MS=30000
REDIS_URL=redis://localhost:6379
# Optional. Unset REDIS_URL to run without Redis: no cache, in-memory rate limits.
CACHE_TTL_S=60
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_LOGIN_PER_MIN=10
PORT=3000
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@statline.local
SEED_ADMIN_PASSWORD=

# ingesta
API_SPORTS_KEY=
API_SPORTS_DAILY_QUOTA=95
# Fallback providers when API-Sports is out of quota or down (SL-20). Empty key disables the NBA one.
FALLBACK_HABILITADO=false
BALLDONTLIE_API_KEY=
THESPORTSDB_API_KEY=3
TEMPORADA_BASQUETBOL=2025-2026
TEMPORADA_AMERICANO=2026
TEMPORADA_FUTBOL=2026
# Metric JSON Schemas, read by ingesta (validation) and api (player aggregates).
# Relative paths resolve from the repo root; the api image sets /app/schemas.
SCHEMAS_DIR=./schemas
