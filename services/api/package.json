{
  "name": "@statline/api",
  "version": "1.0.0",
  "private": true,
  "description": "StatLine REST API (Node 20, Express, Prisma)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "ajv": "8.20.0",
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prisma": "5.22.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "4.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.17.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.15.0",
    "ioredis-mock": "8.13.1",
    "jest": "29.7.0",
    "jest-mock-extended": "3.0.7",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.73.0"
  }
}
